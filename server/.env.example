# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or Local MongoDB)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# JWT Secret for Admin Authentication
JWT_SECRET=super_secret_jwt_key_portfolio_2026

# Default Admin Credentials (Used to automatically seed admin on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000
